{
  "name": "soundcloudapp",
  "productName": "SoundCloud Desktop",
  "version": "0.1.0",
  "description": "SoundCloud desktop player with auto-recording",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}