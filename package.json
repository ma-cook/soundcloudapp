{
  "name": "soundcloudapp",
  "productName": "SoundCloud Desktop",
  "version": "0.1.0",
  "description": "SoundCloud desktop player with auto-recording",
  "license": "MIT",
  "author": {
    "name": "Mitch Master",
    "email": "mitch@example.com"
  },
  "main": "src/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && node fetch-ffmpeg.mjs && electron-builder",
    "dist:dir": "npm run build && node fetch-ffmpeg.mjs && electron-builder --dir",
    "dist:win": "npm run build && node fetch-ffmpeg.mjs --platform windows && electron-builder --win",
    "dist:mac": "npm run build && node fetch-ffmpeg.mjs --platform macos && electron-builder --mac",
    "dist:linux": "npm run build && node fetch-ffmpeg.mjs --platform linux && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mitchmaster.soundclouddesktop",
    "productName": "SoundCloud Desktop",
    "copyright": "Copyright © 2025 Mitch Master",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/renderer/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/${os}",
        "to": "bin",
        "filter": [
          "ffmpeg*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundCloud Desktop"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Audio",
      "maintainer": "Mitch Master <mitch@example.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "SoundCloud Desktop",
        "Comment": "SoundCloud desktop player with auto-recording",
        "Categories": "Audio;AudioVideo;Network;"
      }
    },
    "publish": null
  }
}